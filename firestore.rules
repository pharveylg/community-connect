rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All reads and writes in this app go through Next.js Server Actions
    // using the Firebase Admin SDK (see lib/firebase/admin.ts, lib/firestore.ts),
    // which bypasses these rules entirely. The client SDK never talks to
    // Firestore directly (it's only used for Auth). So every path here is
    // denied as defense in depth — there is no legitimate direct client access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
